    print()
    print("Building fault dictionary...")
    print("This may take time for large ISCAS-85 circuits.")
    print()

    dictionary_start = time.perf_counter()

    # --------------------------------------------------------
    # Build dictionary with progress reporting.
    #
    # For every fault, search through the generated test
    # vectors and record all vectors that detect the fault.
    # --------------------------------------------------------

    fault_dictionary = {}

    total_faults_to_process = len(faults)

    for fault_index, fault in enumerate(
        faults,
        start=1
    ):

        fault_name = str(fault)

        detecting_vectors = []

        for vector_index, vector_data in enumerate(
            test_vectors,
            start=1
        ):

            # test_vectors contain:
            #
            #     (vector_string, input_values)
            #
            vector, input_values = vector_data

            try:

                detected = detect_fault(
                    circuit,
                    input_values,
                    fault
                )

            except TypeError:

                # Compatibility with implementations where
                # detect_fault expects the vector directly.

