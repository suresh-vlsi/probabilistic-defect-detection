        # ----------------------------------------------------
        # Progress display
        # ----------------------------------------------------

        elapsed = (
            time.perf_counter()
            - dictionary_start
        )

        percent = (
            100.0 * fault_index / total_faults_to_process
            if total_faults_to_process
            else 100.0
        )

        print(
            f"\rFaults processed: "
            f"{fault_index:4d}/"
            f"{total_faults_to_process:<4d} "
            f"({percent:6.2f}%) "
            f"Elapsed: {elapsed:8.2f}s",
